# Copy to .env at the repository root. Never commit real credentials.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# live is the primary implementation. demo uses explicitly labeled synthetic data.
PROVIDER_MODE=live
GOOGLE_ROUTES_API_KEY=
# Enable both Routes API and Geocoding API for this server-side key.
# Separate public browser key: enable Maps JavaScript API and restrict websites.
# Never reuse GOOGLE_ROUTES_API_KEY here. Rebuild frontend after changing this.
VITE_GOOGLE_MAPS_API_KEY=
PROVIDER_TIMEOUT_SECONDS=8
WEATHER_CACHE_SECONDS=600
WEATHER_STALE_SECONDS=1800
# Docker Compose frontend port (default: http://localhost:8080).
APP_PORT=8080
# Frontend deployment only: set this at build time, with no trailing slash.
# VITE_API_BASE_URL=https://your-backend.example.com
